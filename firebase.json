{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "node scripts/prepare-functions.mjs",
        "npm --prefix functions run build"
      ]
    }
  ],
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build -w apps/web"],
    "rewrites": [
      { "source": "/api/**", "function": "api" },
      { "source": "/health", "function": "api" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
