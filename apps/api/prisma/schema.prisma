generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Status {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  users      User[]
  customers  Customer[]
  suppliers  Supplier[]
  products   Product[]
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  /** Login id (can be text like cashier1). Falls back to contact for older rows. */
  username     String?   @unique
  /** Phone / contact number (also accepted at login for compatibility). */
  contact      String    @unique
  email        String?
  passwordHash String
  roleId       Int
  statusId     Int
  shopId       String?
  role         Role      @relation(fields: [roleId], references: [id])
  status       Status    @relation(fields: [statusId], references: [id])
  invoices     Invoice[]
  quotations   Quotation[]
  returns      Return[]
  attendances  Attendance[]
  salaries     Salary[]
  cashMoves      CashMovement[]
  sessions       PosSession[]
  stockReleases  StockRelease[]
  createdAt      DateTime  @default(now())
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Unit {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model ProductType {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           Int               @id @default(autoincrement())
  name         String
  code         String            @unique
  description  String?
  categoryId   Int?
  brandId      Int?
  unitId       Int?
  productTypeId Int?
  statusId     Int
  active       Boolean           @default(true)
  category     Category?         @relation(fields: [categoryId], references: [id])
  brand        Brand?            @relation(fields: [brandId], references: [id])
  unit         Unit?             @relation(fields: [unitId], references: [id])
  productType  ProductType?      @relation(fields: [productTypeId], references: [id])
  status       Status            @relation(fields: [statusId], references: [id])
  variants     ProductVariant[]
  createdAt    DateTime          @default(now())
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  name        String
  barcode     String?  @unique
  price       Float    @default(0)
  cost        Float    @default(0)
  size        String?
  color       String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks      Stock[]
  invoiceItems InvoiceItem[]
  quotationItems QuotationItem[]
  grnItems          GrnItem[]
  stockReleaseItems StockReleaseItem[]
}

model Stock {
  id           Int       @id @default(autoincrement())
  variantId    Int
  quantity     Float     @default(0)
  lowThreshold Float     @default(5)
  expireDate   DateTime?
  location     String    @default("store")
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  damaged      DamagedStock[]

  @@index([variantId, location])
}

model StockRelease {
  id        Int      @id @default(autoincrement())
  releaseNo String   @unique
  userId    Int
  note      String?
  user      User     @relation(fields: [userId], references: [id])
  items     StockReleaseItem[]
  createdAt DateTime @default(now())
}

model StockReleaseItem {
  id        Int            @id @default(autoincrement())
  releaseId Int
  variantId Int
  qty       Float
  release   StockRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model DamagedStock {
  id          Int      @id @default(autoincrement())
  stockId     Int
  qty         Float
  reasonId    Int?
  statusId    Int?
  description String?
  createdAt   DateTime @default(now())
  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  reason      DamageReason? @relation(fields: [reasonId], references: [id])
  returnStatus ReturnStatus? @relation(fields: [statusId], references: [id])
}

model DamageReason {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  damaged  DamagedStock[]
}

model ReturnStatus {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  damaged  DamagedStock[]
}

model Company {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  email     String?
  contact   String?
  suppliers Supplier[]
  createdAt DateTime   @default(now())
}

model Bank {
  id        Int        @id @default(autoincrement())
  name      String
  accountNo String?
  suppliers Supplier[]
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  email       String?
  address     String?
  accountNo   String?
  companyId   Int?
  bankId      Int?
  statusId    Int
  company     Company? @relation(fields: [companyId], references: [id])
  bank        Bank?    @relation(fields: [bankId], references: [id])
  status      Status   @relation(fields: [statusId], references: [id])
  grns        Grn[]
  payments    SupplierPayment[]
  createdAt   DateTime @default(now())
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  statusId  Int
  status    Status    @relation(fields: [statusId], references: [id])
  invoices  Invoice[]
  quotations Quotation[]
  createdAt DateTime  @default(now())
}

model Grn {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  billNo        String?
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  note          String?
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  items         GrnItem[]
  payments      SupplierPayment[]
  createdAt     DateTime @default(now())
}

model GrnItem {
  id        Int            @id @default(autoincrement())
  grnId     Int
  variantId Int
  qty       Float
  cost      Float
  grn       Grn            @relation(fields: [grnId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  supplierId Int
  grnId      Int?
  amount     Float
  paymentType String?
  note       String?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  grn        Grn?     @relation(fields: [grnId], references: [id])
}

model Invoice {
  id           Int           @id @default(autoincrement())
  invoiceNo    String        @unique
  customerId   Int?
  userId       Int
  subtotal     Float         @default(0)
  discount     Float         @default(0)
  total        Float         @default(0)
  paymentType  String        @default("Cash")
  paidAmount   Float         @default(0)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  items        InvoiceItem[]
  returns      Return[]
  createdAt    DateTime      @default(now())
}

model InvoiceItem {
  id         Int            @id @default(autoincrement())
  invoiceId  Int
  variantId  Int
  qty        Float
  price      Float
  discount   Float          @default(0)
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])
}

model Return {
  id         Int          @id @default(autoincrement())
  invoiceId  Int
  userId     Int
  total      Float        @default(0)
  note       String?
  invoice    Invoice      @relation(fields: [invoiceId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  items      ReturnItem[]
  createdAt  DateTime     @default(now())
}

model ReturnItem {
  id         Int    @id @default(autoincrement())
  returnId   Int
  variantId  Int
  qty        Float
  price      Float
  discount   Float  @default(0)
  returnRef  Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model Quotation {
  id           Int             @id @default(autoincrement())
  quoteNo      String          @unique
  customerId   Int?
  userId       Int
  subtotal     Float           @default(0)
  discount     Float           @default(0)
  total        Float           @default(0)
  status       String          @default("Active")
  expiresAt    DateTime?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
}

model QuotationItem {
  id          Int            @id @default(autoincrement())
  quotationId Int
  variantId   Int
  qty         Float
  price       Float
  discount    Float          @default(0)
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
}

model Employee {
  id              Int           @id @default(autoincrement())
  name            String
  contact         String?
  email           String?
  roleTitle       String?
  salaryBase      Float         @default(0)
  active          Boolean       @default(true)
  fingerprintCode String?
  attendances     Attendance[]
  salaries        Salary[]
  createdAt       DateTime      @default(now())
}

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  userId     Int?
  date       DateTime
  checkIn    String?
  checkOut   String?
  note       String?
  method     String    @default("manual")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])
}

model Salary {
  id         Int      @id @default(autoincrement())
  employeeId Int
  userId     Int?
  month      String
  amount     Float
  note       String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model CashMovement {
  id        Int      @id @default(autoincrement())
  type      String
  amount    Float
  note      String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model PosSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  counterName  String   @default("Counter 1")
  openingBalance Float  @default(0)
  closingBalance Float?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  user         User     @relation(fields: [userId], references: [id])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model License {
  id          Int       @id @default(autoincrement())
  licenseKey  String    @unique
  status      String    @default("VALID")
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
}

/** Hybrid sync metadata (single row, id=1). */
model SyncState {
  id         Int       @id @default(1)
  lastPushAt DateTime?
  lastPullAt DateTime?
  lastError  String?
  status     String    @default("idle")
  updatedAt  DateTime  @updatedAt
}

/** Failed / pending cloud writes when offline. */
model SyncOutbox {
  id         Int      @id @default(autoincrement())
  collection String
  recordId   String
  op         String   @default("upsert")
  payload    String
  createdAt  DateTime @default(now())
  attempts   Int      @default(0)
  lastError  String?
}
