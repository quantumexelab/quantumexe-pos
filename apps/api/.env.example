# Shop PC (local-first hybrid)
# Primary DB = SQLite. Leave USE_FIRESTORE unset.
DATABASE_URL="file:./dev.db"
JWT_SECRET=quantumexe-dev-secret

# Cloud backup sync (optional). When online, pushes SQLite → Firestore.
SYNC_TO_FIRESTORE=1
SYNC_INTERVAL_MINUTES=5
FIREBASE_PROJECT_ID=quantumexe-pos-test
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@....iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or one-line JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Cloud-only mode (Vercel / Functions) — do NOT use on shop PC with hybrid sync:
# USE_FIRESTORE=1

# PayHere SaaS billing (shop owner → QUANTUMEXE)
# Sandbox: https://sandbox.payhere.lk — create merchant, copy ID + secret
PAYHERE_MODE=sandbox
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# Optional amounts (LKR)
# PAYHERE_AMOUNT_MONTHLY=2000
# PAYHERE_AMOUNT_ANNUAL=20000
# Public URLs for return/cancel/notify (required for PayHere webhooks)
# PUBLIC_API_BASE=https://quantumexe-pos.vercel.app
# PUBLIC_WEB_BASE=https://quantumexe-pos.vercel.app
# Public web checkout via custom domain (e.g. quantumexe.lk) — PayHere rejects *.vercel.app
# PAYHERE_CHECKOUT_BASE=https://quantumexe.lk
# PAYHERE_RETURN_BASE=https://quantumexe.lk
# PUBLIC_API_BASE=https://quantumexe.lk
# PUBLIC_WEB_BASE=https://quantumexe.lk
# Use the Merchant Secret from PayHere Integrations row for quantumexe.lk (not localhost).
