{
  "version": 2,
  "installCommand": "npm install && npm install @rolldown/binding-linux-x64-gnu@1.1.5 --no-save",
  "buildCommand": "npm run prisma:generate -w apps/api && npm run db:push -w apps/api && npm run db:seed -w apps/api && cp -f apps/api/prisma/demo.sqlite api/demo.sqlite && ls -la api/demo.sqlite && npm run build -w apps/api && npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "DATABASE_URL": "file:./demo.sqlite"
    }
  },
  "env": {
    "JWT_SECRET": "reox-clone-dev-secret",
    "USE_FIRESTORE": "1",
    "FIREBASE_PROJECT_ID": "quantumexe-pos-test",
    "PAYHERE_MODE": "sandbox",
    "PUBLIC_API_BASE": "https://pos.quantumexe.com",
    "PUBLIC_WEB_BASE": "https://pos.quantumexe.com",
    "PAYHERE_RETURN_BASE": "https://quantumexe.com",
    "PAYHERE_CHECKOUT_BASE": "https://quantumexe.com",
    "PAYHERE_BRIDGE_PATH": "/api/billing/bridge",
    "PAYHERE_RETURN_PATH": "/pos-return",
    "PAYHERE_CANCEL_PATH": "/pos-cancel"
  },
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "api/demo.sqlite"
    }
  }
}
