# Toggle: set to 1 for Firestore (cloud), leave unset for local SQLite
USE_FIRESTORE=1
FIREBASE_PROJECT_ID=quantumexe-pos

# Vercel / local Admin SDK (blocked by some org policies — prefer Cloud Functions ADC)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Auth
JWT_SECRET=change-me-in-production

# Frontend (Vercel) when API is on Firebase Hosting/Functions
# VITE_API_BASE=https://quantumexe-pos.web.app
