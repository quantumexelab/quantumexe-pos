# Shop PC hybrid (recommended): SQLite primary + optional Firestore backup
# USE_FIRESTORE=   (leave unset)
SYNC_TO_FIRESTORE=1
SYNC_INTERVAL_MINUTES=5
FIREBASE_PROJECT_ID=quantumexe-pos-test
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloud-only (Vercel serverless): set USE_FIRESTORE=1 instead of SYNC_TO_FIRESTORE
# USE_FIRESTORE=1
FIREBASE_PROJECT_ID=quantumexe-pos-test

JWT_SECRET=change-me-in-production

# PayHere (shop SaaS subscriptions) — set on Vercel for live billing
# PAYHERE_MODE=sandbox
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_AMOUNT_MONTHLY=2000
# PAYHERE_AMOUNT_ANNUAL=20000
# PUBLIC_API_BASE=https://quantumexe-pos.vercel.app
# PUBLIC_WEB_BASE=https://quantumexe-pos.vercel.app

# Frontend when API is remote:
# VITE_API_BASE=https://quantumexe-pos.vercel.app
